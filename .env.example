# Öffentlicher EMQX-Testbroker mit verschlüsselter MQTT/TLS-Verbindung.
MQTT_URL=mqtts://broker.emqx.io:8883
MQTT_ALARM_TOPIC=htw/alaa/iot2026/nano-01/commands/alarm
MQTT_ALARM_STATE_TOPIC=htw/alaa/iot2026/nano-01/state/alarm
MQTT_TELEMETRY_TOPIC=htw/alaa/iot2026/nano-01/telemetry

# Öffentliche HTTPS-Adresse der Pi-Kontroll-API (z. B. Cloudflare Tunnel).
PI_CONTROL_URL=https://pi-control.example.com
PI_CONTROL_TOKEN=ein-langes-zufaelliges-token

# Optional, falls Mosquitto Zugangsdaten verlangt:
# MQTT_USERNAME=
# MQTT_PASSWORD=
