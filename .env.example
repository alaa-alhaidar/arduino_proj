# Privater EMQX-Cloud-Broker mit verschlüsselter MQTT/TLS-Verbindung.
MQTT_URL=mqtts://jfa0c01f.ala.eu-central-1.emqxsl.com:8883
MQTT_ALARM_TOPIC=htw/alaa/iot2026/nano-01/commands/alarm
MQTT_ALARM_STATE_TOPIC=htw/alaa/iot2026/nano-01/state/alarm
MQTT_TELEMETRY_TOPIC=htw/alaa/iot2026/nano-01/telemetry
MQTT_PI_CONTROL_TOPIC=htw/alaa/iot2026/pi-05/commands/control
MQTT_PI_CONTROL_STATE_TOPIC=htw/alaa/iot2026/pi-05/state/control

# Gemeinsames Geheimnis für erlaubte MQTT-Steuerbefehle.
PI_CONTROL_TOKEN=ein-langes-zufaelliges-token

# HTTPS-Basis-URL des öffentlich erreichbaren Pi-Kamera-Relays, ohne /frame.
CAMERA_RELAY_URL=https://camera.example.com
# Nur serverseitig verwenden; muss CAMERA_VIEW_TOKEN auf dem Pi entsprechen.
CAMERA_VIEW_TOKEN=ein-anderes-langes-zufaelliges-token

# Zugangsdaten des privaten EMQX-Brokers (nur in .env.local eintragen):
MQTT_USERNAME=dein-benutzername
MQTT_PASSWORD=dein-passwort
