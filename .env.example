# Next.js läuft auf dem Mac und erreicht den MQTT-Broker im lokalen Netz auf dem Pi 5.
MQTT_URL=mqtt://192.168.178.128:1883
MQTT_ALARM_TOPIC=iot/v1/nodes/pi-05/commands/alarm
MQTT_ALARM_STATE_TOPIC=iot/v1/nodes/pi-05/state/alarm
MQTT_TELEMETRY_TOPIC=iot/v1/nodes/pi-05/telemetry

# Optional, falls Mosquitto Zugangsdaten verlangt:
# MQTT_USERNAME=
# MQTT_PASSWORD=
