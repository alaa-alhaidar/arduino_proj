# Next.js läuft auf dem Mac und erreicht den MQTT-Broker im lokalen Netz auf dem Pi 5.
MQTT_URL=mqtt://192.168.178.128:1883
MQTT_ALARM_TOPIC=iot/v1/nodes/pi-05/commands/alarm
MQTT_ALARM_STATE_TOPIC=iot/v1/nodes/pi-05/state/alarm
MQTT_TELEMETRY_TOPIC=iot/v1/nodes/pi-05/telemetry

# Öffentliche HTTPS-Adresse der Pi-Kontroll-API (z. B. Cloudflare Tunnel).
PI_CONTROL_URL=https://pi-control.example.com
PI_CONTROL_TOKEN=ein-langes-zufaelliges-token

# Optional, falls Mosquitto Zugangsdaten verlangt:
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Weboberflächen der beiden ESP32-CAMs im lokalen Netz:
NEXT_PUBLIC_ESP_CAM_1_URL=http://192.168.178.135
NEXT_PUBLIC_ESP_CAM_2_URL=http://192.168.178.133
