# Separater Zielport ausschließlich für die kontrollierte DoS-Demo.
DOS_GUARD_HOST=0.0.0.0
DOS_GUARD_PORT=8088

# Alarm ab 80 Anfragen derselben IP innerhalb von 10 Sekunden.
DOS_GUARD_WINDOW_SECONDS=10
DOS_GUARD_REQUEST_THRESHOLD=80
DOS_GUARD_BLOCK_SECONDS=60

# Zuerst false verwenden. true aktiviert eine temporäre, nur auf Port 8088
# begrenzte iptables-Sperre und benötigt den Systemdienst mit CAP_NET_ADMIN.
DOS_GUARD_ENFORCE=false

# Diese Netze lösen niemals Alarm oder Sperren aus. Bei Bedarf die feste
# Management-IP ergänzen, aber NICHT die IP des Test-Macs.
DOS_GUARD_ALLOW=127.0.0.0/8,::1/128
DOS_GUARD_STATE_FILE=/home/alaa/pi-control/dos-guard-state.json

PUBLIC_MQTT_HOST=jfa0c01f.ala.eu-central-1.emqxsl.com
PUBLIC_MQTT_PORT=8883
PUBLIC_MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt
MQTT_DOS_GUARD_TOPIC=htw/alaa/iot2026/pi-05/security/dos
