[Unit]
Description=HTTPS tunnel for Sensor Campus camera relay
After=network-online.target pi-camera-relay.service
Wants=pi-camera-relay.service

[Service]
Type=simple
ExecStart=/home/alaa/.local/bin/cloudflared tunnel --no-autoupdate --logfile /home/alaa/pi-control/camera-tunnel.log --url http://127.0.0.1:8767
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
